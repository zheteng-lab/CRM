<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Academy CRM v3.0</title>
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.25/jspdf.plugin.autotable.min.js"></script>
</head>
<body class="bg-slate-50 font-sans text-slate-900">

    <nav class="bg-slate-900 text-white p-4 sticky top-0 z-50 shadow-md">
        <div class="max-w-7xl mx-auto flex flex-wrap justify-between items-center gap-4">
            <h1 class="font-black text-xl tracking-tighter text-indigo-400">ACADEMY CRM</h1>
            <div class="flex flex-wrap gap-2">
                <button onclick="showPage('stats')" class="nav-btn bg-slate-800 px-4 py-2 rounded hover:bg-indigo-600 transition">📊 Dashboard</button>
                <button onclick="showPage('students')" class="nav-btn bg-slate-800 px-4 py-2 rounded hover:bg-indigo-600 transition">🎓 Students</button>
                <button onclick="showPage('teachers')" class="nav-btn bg-slate-800 px-4 py-2 rounded hover:bg-indigo-600 transition">👨‍🏫 Teachers</button>
                <button onclick="showPage('export')" class="nav-btn bg-slate-800 px-4 py-2 rounded hover:bg-red-700 transition">📄 Export PDF</button>
            </div>
        </div>
    </nav>

    <div class="max-w-7xl mx-auto p-4 md:p-8">
        
        <div id="page-stats" class="page-content">
            <div class="flex justify-between items-center mb-6">
                <h2 class="text-2xl font-bold">Monthly Performance</h2>
                <input type="month" id="stats-month" onchange="fetchData()" class="border p-2 rounded shadow-sm">
            </div>
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
                <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
                    <h3 class="text-indigo-600 font-bold mb-4 uppercase text-sm tracking-widest">Student Funnel</h3>
                    <div id="student-dashboard" class="grid grid-cols-2 sm:grid-cols-3 gap-3"></div>
                </div>
                <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
                    <h3 class="text-emerald-600 font-bold mb-4 uppercase text-sm tracking-widest">Teacher Funnel</h3>
                    <div id="teacher-dashboard" class="grid grid-cols-2 sm:grid-cols-3 gap-3"></div>
                </div>
            </div>
        </div>

        <div id="page-students" class="page-content hidden">
            <h2 class="text-2xl font-bold mb-6">Manage Students</h2>
            <div class="bg-indigo-600 p-6 rounded-2xl shadow-lg mb-8 text-white flex flex-wrap gap-4 items-end">
                <div class="flex-1 min-w-[200px]">
                    <label class="block text-xs font-bold mb-1 opacity-80">STUDENT NAME</label>
                    <input id="s-name" type="text" class="w-full p-2 rounded text-slate-900 border-none">
                </div>
                <div class="flex-1 min-w-[200px]">
                    <label class="block text-xs font-bold mb-1 opacity-80">PHONE NUMBER</label>
                    <input id="s-phone" type="text" class="w-full p-2 rounded text-slate-900 border-none">
                </div>
                <button onclick="addItem('student')" class="bg-white text-indigo-600 font-bold px-8 py-2 rounded hover:bg-indigo-50 transition">Add Lead</button>
            </div>
            <div id="student-list" class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden"></div>
        </div>

        <div id="page-teachers" class="page-content hidden">
            <h2 class="text-2xl font-bold mb-6">Manage Teachers</h2>
            <div class="bg-emerald-600 p-6 rounded-2xl shadow-lg mb-8 text-white flex flex-wrap gap-4 items-end">
                <div class="flex-1 min-w-[200px]">
                    <label class="block text-xs font-bold mb-1 opacity-80">TEACHER PHONE NUMBER</label>
                    <input id="t-phone" type="text" placeholder="Entry by phone only" class="w-full p-2 rounded text-slate-900 border-none">
                </div>
                <button onclick="addItem('teacher')" class="bg-white text-emerald-600 font-bold px-8 py-2 rounded hover:bg-emerald-50 transition">Add Lead</button>
            </div>
            <div id="teacher-list" class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden"></div>
        </div>

        <div id="page-export" class="page-content hidden">
            <div class="max-w-2xl mx-auto bg-white p-8 rounded-3xl shadow-xl border border-slate-100 mt-10 text-center">
                <h2 class="text-3xl font-black mb-2">Generate Report</h2>
                <p class="text-slate-500 mb-8 text-sm">Select a date range to generate a PDF summary.</p>
                
                <div class="flex flex-col sm:flex-row gap-4 mb-8">
                    <div class="flex-1">
                        <label class="block text-left text-xs font-bold text-slate-400 mb-1">FROM DATE</label>
                        <input type="date" id="export-start" class="w-full p-3 border rounded-xl">
                    </div>
                    <div class="flex-1">
                        <label class="block text-left text-xs font-bold text-slate-400 mb-1">TO DATE</label>
                        <input type="date" id="export-end" class="w-full p-3 border rounded-xl">
                    </div>
                </div>
                
                <button onclick="generatePDF()" class="w-full bg-red-600 text-white font-bold py-4 rounded-xl hover:bg-red-700 shadow-lg shadow-red-200 transition">
                    Download PDF Document
                </button>
            </div>
        </div>

    </div>

    <script>
        const SUPABASE_URL = 'https://sizkhdpfhfpcflyxwfnq.supabase.co';
        const SUPABASE_KEY = 'sb_publishable_Oi7djoe5vli1NuoC4xHubw_k0BCv-aA';
        const supabaseClient = supabase.createClient(SUPABASE_URL, SUPABASE_KEY);

        const STUDENT_STATUSES = ["New", "Follow Up Parents", "No Respond", "Arrange Voucher", "Rejected", "Enrollment"];
        const TEACHER_STATUSES = ["New", "Follow Up Teacher", "No Respond", "Pending Payment", "Paid Fees", "Rejected", "Onboard"];

        let masterData = [];

        // Set default month
        document.getElementById('stats-month').value = new Date().toISOString().slice(0, 7);

        function showPage(pageId) {
            document.querySelectorAll('.page-content').forEach(p => p.classList.add('hidden'));
            document.getElementById('page-' + pageId).classList.remove('hidden');
            fetchData();
        }

        async function fetchData() {
            const { data, error } = await supabaseClient.from('leads').select('*').order('created_at', { ascending: false });
            if (!error) {
                masterData = data;
                renderDashboard();
                renderTable('student', STUDENT_STATUSES);
                renderTable('teacher', TEACHER_STATUSES);
            }
        }

        function calculateDueStatus(createdDate, status, type) {
            const now = new Date();
            const created = new Date(createdDate);
            const daysPassed = Math.floor((now - created) / (1000 * 60 * 60 * 24));
            
            let deadline = 0;
            if (type === 'student') {
                if (status === "New") deadline = 5;
                else if (status.includes("Follow Up") || status === "No Respond") deadline = 10;
                else if (status === "Arrange Voucher") deadline = 30;
            } else {
                if (status === "New") deadline = 5;
                else if (status.includes("Follow Up") || status === "No Respond") deadline = 15;
                else if (status.includes("Payment")) deadline = 20;
            }

            if (deadline === 0 || ["Enrollment", "Rejected", "Onboard"].includes(status)) return "";
            
            const remaining = deadline - daysPassed;
            if (remaining < 0) return `<span class="text-[10px] font-bold bg-red-100 text-red-600 px-2 py-0.5 rounded ml-2">OVERDUE</span>`;
            return `<span class="text-[10px] font-bold bg-amber-100 text-amber-600 px-2 py-0.5 rounded ml-2">${remaining}D LEFT</span>`;
        }

        async function addItem(type) {
            const name = type === 'student' ? document.getElementById('s-name').value : 'Teacher Lead';
            const phone = document.getElementById(type === 'student' ? 's-phone' : 't-phone').value;
            if (!phone) return alert("Phone is required");
            await supabaseClient.from('leads').insert([{ name, phone, person_type: type, status: 'New' }]);
            fetchData();
            document.querySelectorAll('input').forEach(i => i.type === 'text' ? i.value = '' : null);
        }

        async function updateStatus(id, newStatus) {
            await supabaseClient.from('leads').update({ status: newStatus }).eq('id', id);
            fetchData();
        }

        function renderDashboard() {
            const month = document.getElementById('stats-month').value;
            const filtered = masterData.filter(d => d.created_at.startsWith(month));
            
            const buildStats = (type, statuses, elementId) => {
                const data = filtered.filter(d => d.person_type === type);
                document.getElementById(elementId).innerHTML = statuses.map(s => `
                    <div class="bg-slate-50 p-4 rounded-xl border border-slate-100">
                        <div class="text-slate-400 font-bold text-[10px] uppercase">${s}</div>
                        <div class="text-2xl font-black text-slate-800">${data.filter(d => d.status === s).length}</div>
                    </div>
                `).join('');
            };
            buildStats('student', STUDENT_STATUSES, 'student-dashboard');
            buildStats('teacher', TEACHER_STATUSES, 'teacher-dashboard');
        }

        function renderTable(type, statuses) {
            const data = masterData.filter(d => d.person_type === type);
            const container = document.getElementById(type + '-list');
            container.innerHTML = `
                <table class="w-full text-left">
                    <thead class="bg-slate-50 text-slate-400 text-xs font-bold uppercase">
                        <tr><th class="p-4">Lead Date</th><th class="p-4">Contact</th><th class="p-4">Status & Deadline</th><th class="p-4 text-right">Action</th></tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        ${data.map(item => `
                            <tr class="hover:bg-slate-50">
                                <td class="p-4 text-xs font-mono text-slate-400">${item.created_at.split('T')[0]}</td>
                                <td class="p-4">
                                    <div class="font-bold text-slate-700">${item.name}</div>
                                    <div class="text-xs text-slate-400">${item.phone}</div>
                                </td>
                                <td class="p-4">
                                    <div class="flex items-center">
                                        <select onchange="updateStatus('${item.id}', this.value)" class="border rounded p-1 text-sm bg-white">
                                            ${statuses.map(s => `<option value="${s}" ${item.status === s ? 'selected' : ''}>${s}</option>`).join('')}
                                        </select>
                                        ${calculateDueStatus(item.created_at, item.status, type)}
                                    </div>
                                </td>
                                <td class="p-4 text-right"><button onclick="deleteItem('${item.id}')" class="text-slate-300 hover:text-red-500">✕</button></td>
                            </tr>
                        `).join('')}
                    </tbody>
                </table>`;
        }

        async function deleteItem(id) {
            if(confirm("Delete permanently?")) {
                await supabaseClient.from('leads').delete().eq('id', id);
                fetchData();
            }
        }

        function generatePDF() {
            const { jsPDF } = window.jspdf;
            const doc = new jsPDF();
            const start = document.getElementById('export-start').value;
            const end = document.getElementById('export-end').value;

            if(!start || !end) return alert("Select date range");

            const filtered = masterData.filter(d => {
                const date = d.created_at.split('T')[0];
                return date >= start && date <= end;
            });

            doc.setFontSize(18);
            doc.text("ACADEMY CRM REPORT", 14, 20);
            doc.setFontSize(10);
            doc.text(`Period: ${start} to ${end}`, 14, 28);

            const tableData = filtered.map(d => [
                d.created_at.split('T')[0],
                d.person_type.toUpperCase(),
                d.name,
                d.phone,
                d.status
            ]);

            doc.autoTable({
                head: [['Date', 'Type', 'Name', 'Phone', 'Status']],
                body: tableData,
                startY: 35,
                theme: 'striped'
            });

            doc.save(`CRM_Report_${start}_to_${end}.pdf`);
        }

        showPage('stats');
    </script>
</body>
</html>
